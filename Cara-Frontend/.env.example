# Run: python server.py config (creates a private .env outside this web folder).
# Never put secret keys in store-data.js or the public website folder.
CARA_PUBLIC_URL=http://localhost:5502
CARA_COOKIE_SECURE=0
# Public deployment: HTTPS URL above, secure cookies=1, then enable after provider setup.
CARA_ONLINE_PAYMENTS_ENABLED=0
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
# Additional exact frontend origins, comma-separated. No wildcard.
CARA_ALLOWED_ORIGINS=
# Address names/search provider. Use your own Photon instance for larger traffic.
CARA_GEOCODER_URL=https://photon.komoot.io
